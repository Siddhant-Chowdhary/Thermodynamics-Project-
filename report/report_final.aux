\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Freeze concentration in 0.9\,wt\% saline with the per-OH model. (a) Unfrozen fraction of the water. (b) NaCl in the unfrozen medium. (c) Salt inside a cell at osmotic equilibrium. Glycerol penetrates and sorbitol does not, so the saline-only and sorbitol-only curves coincide. (d) Minimum glycerol at $-15$\,\textdegree C against sorbitol added under three literature criteria. The purple band shows all three at once with its optimum.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cells}{{5}{5}{Freeze concentration in 0.9\,wt\% saline with the per-OH model. (a) Unfrozen fraction of the water. (b) NaCl in the unfrozen medium. (c) Salt inside a cell at osmotic equilibrium. Glycerol penetrates and sorbitol does not, so the saline-only and sorbitol-only curves coincide. (d) Minimum glycerol at $-15$\,\textdegree C against sorbitol added under three literature criteria. The purple band shows all three at once with its optimum}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Post hoc per-OH constant implied by sucrose data near 0\,\textdegree C and at 25\,\textdegree C, with $a=h-Ts$ fitted on two matched molality windows.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:gh}{{6}{5}{Post hoc per-OH constant implied by sucrose data near 0\,\textdegree C and at 25\,\textdegree C, with $a=h-Ts$ fitted on two matched molality windows}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Sorbitol at 25\,\textdegree C \cite  {bower}. With glycerol's constant the per-OH model overstates non-ideality. An older freezing-point set \cite  {baer} is implausible at infinite dilution, where $\phi $ must tend to 1.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sorbitol}{{7}{5}{Sorbitol at 25\,\textdegree C \cite {bower}. With glycerol's constant the per-OH model overstates non-ideality. An older freezing-point set \cite {baer} is implausible at infinite dilution, where $\phi $ must tend to 1}{figure.caption.8}{}}
